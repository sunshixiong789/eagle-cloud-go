# Compose 默认使用阿里云 OSS。创建 Bucket 后填写地域、Bucket 和 RAM 凭据。
# 未创建 OSS 时可显式设置 EAGLE_FILE_PROVIDER=local；文件存入 uploads 卷。
EAGLE_FILE_PROVIDER=oss
# 例如 cn-hangzhou，必须与 Bucket 实际地域一致。
EAGLE_FILE_OSS_REGION=
EAGLE_FILE_OSS_BUCKET=
# 留空由 SDK 推导 HTTPS 公网地址；可填同地域 internal endpoint。
EAGLE_FILE_OSS_ENDPOINT=
EAGLE_FILE_OSS_ACCESS_KEY_ID=
EAGLE_FILE_OSS_ACCESS_KEY_SECRET=
# 使用临时 STS 凭据时填写，并在过期前更新凭据、重启 admin。
EAGLE_FILE_OSS_SECURITY_TOKEN=

# 0.162.0 尚无通用多架构标签；对应平台可显式填写 0.162.0-arm64/amd64。
EAGLE_OTEL_IMAGE_TAG=0.161.0
