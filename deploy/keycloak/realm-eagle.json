{
  "realm": "eagle",
  "enabled": true,
  "displayName": "Eagle",

  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "sslRequired": "none",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,

  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "system 域管理员，由本库 realm:admin 策略授权"
      },
      {
        "name": "user",
        "description": "普通用户，仅只读权限"
      }
    ],
    "client": {
      "eagle-admin": [{"name": "admin"}],
      "eagle-product": [{"name": "admin"}],
      "eagle-order": [{"name": "admin"}]
    }
  },

  "clients": [
    {
      "clientId": "eagle-web",
      "name": "Eagle 管理后台（前端）",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-eagle-system",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "eagle-system",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience-eagle-admin",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "eagle-admin",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience-eagle-product",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "eagle-product",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience-eagle-order",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "eagle-order",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "eagle-system",
      "name": "Eagle System 服务（资源服务器）",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "eagle-admin",
      "name": "Eagle Admin 服务",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "eagle-product",
      "name": "Eagle Product 服务",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "eagle-order",
      "name": "Eagle Order 服务",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "eagle-worker",
      "name": "Eagle 后台任务（服务账号）",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-only-worker-secret",
      "attributes": {
        "use.refresh.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-eagle-system",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "eagle-system",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience-eagle-admin",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "eagle-admin",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience-eagle-product",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "eagle-product",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience-eagle-order",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "eagle-order",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
